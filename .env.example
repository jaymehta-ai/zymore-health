# ==============================================================================
# Zymore Health - Environment Variables Template
# Copy this file to apps/web/.env.local and configure your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Browser visible)
# Found in: Firebase Console -> Project Settings -> General -> Web Apps
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseWebApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK Configuration (Server-only credentials)
# Found in: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# IMPORTANT: In .env.local, preserve newlines in the private key using \n
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Comma-separated Firebase Auth user UIDs granted staff reviewer access for doctor approvals
DOCTOR_REVIEWER_UIDS="admin_user_uid_1,admin_user_uid_2"

# ------------------------------------------------------------------------------
# 3. Google Gemini API Configuration (Server-only credentials)
# Generated from: Google AI Studio (https://aistudio.google.com/app/apikey)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-3.8-flash"

# ------------------------------------------------------------------------------
# 4. Supabase Storage S3 Configuration (Server-only credentials)
# Found in: Supabase Dashboard -> Project Settings -> Storage -> S3 Credentials
# ------------------------------------------------------------------------------
SUPABASE_S3_ENDPOINT="https://your-project-ref.storage.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="ap-south-1"
SUPABASE_S3_ACCESS_KEY_ID="your-supabase-s3-access-key-id"
SUPABASE_S3_SECRET_ACCESS_KEY="your-supabase-s3-secret-access-key"
SUPABASE_STORAGE_BUCKET="health-records"
